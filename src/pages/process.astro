---
import Layout from '../layouts/Layout.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import { getLocalizedPath, type Lang } from '../i18n/utils';

const lang: Lang = 'en';
const estimatePath = getLocalizedPath('estimate', lang);
---

<Layout 
  title="Our 5-Stage Migration Process | Zero-Downtime SOP"
  description="Explore SiteCarry's disciplined 5-stage website migration process. From URL inventory to staging reviews and zero-downtime cutover."
  lang={lang}
>
  <div class="py-20 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          A Disciplined, Zero-Surprise Workflow
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          We don't believe in "move fast and break things" when your business revenue depends on your live website. Every migration follows a rigorous 5-stage engineering checklist.
        </p>
      </div>

      <!-- Process Timeline Component -->
      <ProcessTimeline lang={lang} />

      <!-- Guarantees & Safeguards -->
      <div class="mt-20 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-8 rounded-xl bg-slate-50/70 border border-slate-200 shadow-2xs space-y-2.5">
          <h3 class="text-lg font-bold text-slate-900">
            Zero-Downtime DNS Cutover
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed font-normal">
            Your live WordPress site remains fully operational throughout development. On launch day, we shift DNS via Cloudflare with a verified rollback protocol ready in the unlikely event of any anomaly.
          </p>
        </div>

        <div class="p-8 rounded-xl bg-slate-50/70 border border-slate-200 shadow-2xs space-y-2.5">
          <h3 class="text-lg font-bold text-slate-900">
            Complete 301 Redirect Parity
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed font-normal">
            Every old URL is preserved or permanently redirected. We crawl the staging environment against your production sitemap to guarantee zero 404 errors before public switchover.
          </p>
        </div>
      </div>

      <div class="mt-16 text-center">
        <a href={estimatePath} class="inline-block px-8 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-sm shadow-amber-500/20 transition-all">
          Schedule Your Migration Kickoff
        </a>
      </div>

    </div>
  </div>
</Layout>
