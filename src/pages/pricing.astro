---
import Layout from '../layouts/Layout.astro';
import PricingTable from '../components/PricingTable.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteConfig } from '../data/siteConfig';
import { getLocalizedPath, type Lang } from '../i18n/utils';

const lang: Lang = 'en';
const estimatePath = getLocalizedPath('estimate', lang);
const checkoutPath = getLocalizedPath('checkout', lang);

const breadcrumbs = [
  { label: 'Pricing' },
];
---

<Layout 
  title="Pricing & Migration Packages | Transparent Fixed Quotes"
  description="Transparent fixed pricing for WordPress migration and website rebuilds. Packages starting from $1,490. No hidden hourly meters."
  lang={lang}
>
  <div class="py-12 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbs} lang={lang} className="mb-8" />
      
      <!-- Top Title -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Transparent, Predictable Investment
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          We don't bill by open-ended hours that spiral out of control. We agree on an explicit scope of work, deliver on staging, and guarantee our code with a 30-day post-launch warranty.
        </p>
      </div>

      <!-- Main Pricing Cards -->
      <PricingTable lang={lang} showAllDetails={true} />

      <!-- Deep Evaluation Review Tier Callout -->
      <div class="mt-16 p-8 sm:p-10 rounded-xl bg-slate-50 border border-slate-200 max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xs">
        <div class="space-y-3">
          <span class="text-xs font-semibold text-slate-700 bg-slate-100 border border-slate-200 px-2.5 py-1 rounded-md inline-block">
            Step 0: Low-Risk Verification
          </span>
          <h2 class="text-2xl font-bold text-slate-900">Migration Review ($149 USD)</h2>
          <p class="text-sm text-slate-600 leading-relaxed max-w-xl">
            A comprehensive 3–5 business day diagnostic: headless URL crawler inventory, plugin risk matrix, database sanitization plan, and architecture proposal. 
            <strong class="text-slate-900 font-semibold">100% credited toward your migration package</strong> if you sign within 30 days.
          </p>
        </div>
        <a href={`${checkoutPath}?plan=review-149`} class="shrink-0 px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-sm shadow-amber-500/20 transition-all">
          Pay $149 Online & Start Review
        </a>
      </div>

      <!-- Add-Ons Table -->
      <div class="mt-20 max-w-5xl mx-auto">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">Transparent Add-On Rates</h2>
          <p class="text-sm text-slate-600">Need more pages, another language branch, or custom integrations? All scope additions are priced upfront before implementation.</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-2xs">
          <table class="w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-xs tracking-wider">
              <tr>
                <th class="px-6 py-3.5">Add-On Scope</th>
                <th class="px-6 py-3.5">Estimated Rate</th>
                <th class="px-6 py-3.5">Unit</th>
                <th class="px-6 py-3.5">Scope Details</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {siteConfig.addOns.map((add) => (
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="px-6 py-4 font-medium text-slate-900">{add.item}</td>
                  <td class="px-6 py-4 text-blue-600 font-bold font-mono">{add.priceRange}</td>
                  <td class="px-6 py-4 text-slate-500 font-mono text-xs">{add.unit}</td>
                  <td class="px-6 py-4 text-slate-600 text-xs">{add.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Care Maintenance Plans -->
      <div class="mt-20 max-w-5xl mx-auto">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">Monthly Care & Monitoring Plans</h2>
          <p class="text-sm text-slate-600">Optional monthly maintenance after your 30-day post-launch warranty period.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {siteConfig.carePlans.map((plan) => (
            <div class="p-8 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between">
              <div>
                <div class="flex justify-between items-baseline mb-4">
                  <h3 class="text-xl font-bold text-slate-900">{plan.name}</h3>
                  <div class="text-right">
                    <span class="text-2xl font-extrabold text-slate-900 font-mono">{plan.monthlyFeeDisplay}</span>
                    <span class="text-xs text-slate-500 font-mono"> / month</span>
                  </div>
                </div>
                <p class="text-sm text-slate-600 mb-6 font-normal">{plan.description}</p>
                <ul class="space-y-2.5 text-sm text-slate-600 mb-8">
                  {plan.features.map((f) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <a href={`${estimatePath}?care=${plan.id}`} class="py-3 px-4 rounded-xl bg-slate-50 hover:bg-amber-500 hover:text-slate-950 border border-slate-200 text-slate-800 text-xs font-semibold text-center transition-all">
                Inquire About {plan.name}
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Scope & Counting Rules -->
      <div class="mt-20 max-w-5xl mx-auto p-8 rounded-xl bg-slate-50 border border-slate-200 space-y-4 text-sm text-slate-600 shadow-2xs">
        <h3 class="text-base font-bold text-slate-900 tracking-tight">Payment Schedule & Scope Rules</h3>
        <ul class="space-y-3 text-slate-600 list-disc list-inside">
          <li><strong class="text-slate-800">Inquiry & Payment Terms:</strong> We do not charge credit cards online. Every project begins with a free technical site crawl and scope assessment. Once we confirm the exact deliverables and timeline, we sign a fixed-scope contract.</li>
          <li><strong class="text-slate-800">Payment Schedule:</strong> Essential is 50% deposit upon kickoff, 50% upon preview staging acceptance prior to live DNS cutover. Business and Enterprise packages are 40% kickoff, 40% preview staging acceptance, 20% prior to live cutover.</li>
          <li><strong class="text-slate-800">WooCommerce & E-Commerce Scope:</strong> Enterprise rebuilds decouple the storefront via Next.js Commerce with hosted PCI-compliant checkout (Stripe / Shopify). We migrate product catalogs, attribute variations, and customer order history. Specialized ERP/inventory custom syncs are quoted transparently during technical intake.</li>
          <li><strong class="text-slate-800">Revision Rounds:</strong> Each build includes 2 consolidated revision rounds on the staging environment. Fixing defects to match the agreed specification does not consume revision rounds.</li>
          <li><strong class="text-slate-800">Hosting Accounts:</strong> We deploy to your own client accounts (e.g., Cloudflare Pages, Vercel, AWS). You retain 100% ownership of source repositories and credentials.</li>
          <li><strong class="text-slate-800">Content & Translations:</strong> Client provides finalized text and translated copy. Bulk articles are migrated with automated format cleaning; manual rewrite of copywriting is excluded.</li>
        </ul>
      </div>

    </div>
  </div>
</Layout>
