---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';

const lang: Lang = 'en';
const estimatePath = getLocalizedPath('estimate', lang);

const breadcrumbs = [
  { label: 'Guides' },
];

const articles = [
  {
    slug: "php2shell-wordpress-static-mitigation",
    image: "/images/guide-zero-attack-surface.png",
    tag: "Security Architecture",
    date: "October 22, 2026",
    title: "PHP2shell (CVE-2026-109618): Why Decoupled Static Architecture is the Ultimate Defense Against Recurring PHP Exploits",
    excerpt: "An engineering perspective on the recent unauthenticated PHP core RCE vulnerabilities, and why transitioning enterprise WordPress sites to a decoupled static edge stack eliminates the recurring patch cycle permanently.",
    readTime: "6 min read",
  },
];
---

<Layout 
  title="Migration Guides & Technical Insights | SiteCarry"
  description="Engineering insights on WordPress migration, URL 301 mappings, Core Web Vitals optimization, and decoupled static security architecture."
  lang={lang}
>
  <div class="py-12 sm:py-20 bg-gradient-to-b from-slate-50 via-white to-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbs} lang={lang} className="mb-8" />

      <div class="max-w-3xl mb-16">
        <span class="text-xs font-mono uppercase tracking-widest text-blue-600 font-semibold mb-2 block">Knowledge & Analysis</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Migration Guides & Insights
        </h1>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          In-depth technical analysis for engineering leads, site owners, and digital directors planning modern website migrations.
        </p>
      </div>

      <div class="max-w-5xl">
        {articles.map((art) => (
          <article class="rounded-3xl bg-white border border-slate-200 hover:border-blue-400 overflow-hidden shadow-sm hover:shadow-md transition-all grid grid-cols-1 lg:grid-cols-12">
            <div class="lg:col-span-5 relative bg-slate-100 overflow-hidden group min-h-[240px]">
              <img 
                src={art.image} 
                alt={art.title} 
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            <div class="lg:col-span-7 p-8 sm:p-10 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs font-mono text-slate-500 mb-4">
                  <span class="text-amber-700 font-bold uppercase tracking-wider">{art.tag}</span>
                  <span>{art.date}</span>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 mb-3 hover:text-amber-700 transition-colors leading-snug">
                  <a href={getLocalizedPath(`guides/${art.slug}`, lang)}>{art.title}</a>
                </h2>
                <p class="text-xs text-slate-600 leading-relaxed mb-6">
                  {art.excerpt}
                </p>
              </div>
              <div class="flex items-center justify-between pt-4 border-t border-slate-200 text-xs font-mono">
                <span class="text-slate-500">{art.readTime}</span>
                <a href={getLocalizedPath(`guides/${art.slug}`, lang)} class="text-amber-700 hover:text-amber-900 transition-colors font-semibold">
                  Read Full Analysis
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</Layout>
