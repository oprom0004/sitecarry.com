---
import Layout from '../layouts/Layout.astro';
import VisualUrlMapper from '../components/VisualUrlMapper.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getLocalizedPath, type Lang } from '../i18n/utils';

const lang: Lang = 'en';
const estimatePath = getLocalizedPath('estimate', lang);

const breadcrumbs = [
  { label: 'Work & Benchmarks' },
];

const demoProjects = [
  {
    type: "Benchmark 01",
    image: "/images/demo-b2b-portal.png",
    title: "Corporate B2B Equipment Portal",
    from: "WordPress 6.4 + Elementor (28 active plugins) on $49/mo VPS",
    to: "Astro 7 Static Build on Cloudflare Pages ($0/mo Edge)",
    scope: {
      pages: "15 core pages",
      posts: "180 technical articles",
      templates: "5 custom responsive layouts",
      forms: "2 serverless validated endpoints",
    },
    metrics: [
      { label: "Speed Index", before: "6.2s", after: "0.8s" },
      { label: "Lighthouse", before: "43 / 100", after: "99 / 100" },
      { label: "Public PHP/SQL", before: "Port 80/443 exposed", after: "Zero Attack Surface" },
      { label: "Hosting Cost", before: "$49 / month", after: "$0 / month (Cloudflare)" },
    ],
    verifiedItems: [
      "100% 1:1 URL parity across all 195 endpoints with verified 301 rules",
      "Elementor shortcodes transformed into modular semantic Astro components",
      "Serverless contact form with honeypot spam protection & Resend delivery",
      "Client Git repository handed over with automated CI/CD deployment scripts",
    ],
  },
  {
    type: "Benchmark 02",
    image: "/images/demo-tech-publishing.png",
    title: "High-Volume Tech Publishing Hub",
    from: "Monolithic WordPress (MySQL bottleneck on traffic spikes)",
    to: "Next.js App Router (ISR + Decoupled Headless WP Editor)",
    scope: {
      pages: "25 custom landing pages",
      posts: "850 historical articles with tags & author archives",
      templates: "7 modular templates",
      forms: "Lead capture + Newsletter subscription webhook",
    },
    metrics: [
      { label: "TTFB Latency", before: "1,150ms", after: "45ms" },
      { label: "Core Web Vitals", before: "Failed (LCP 4.8s)", after: "Passed (LCP 1.1s)" },
      { label: "Editorial Flow", before: "Disrupted", after: "Retained WP dashboard (Headless)" },
      { label: "301 Redirect Rules", before: "N/A", after: "875 verified edge rules" },
    ],
    verifiedItems: [
      "Headless WPGraphQL content synchronization layer",
      "Automatic ISR regeneration on post publish/edit",
      "Fast instant client-side search with zero server load",
      "Exhaustive Screaming Frog crawl verification before and after cutover",
    ],
  },
];
---

<Layout 
  title="Work & Verifiable Demo Migrations | SiteCarry"
  description="Transparent specifications of our migration deliverables, UI mockups, testing protocols, and real architectural benchmarks."
  lang={lang}
>
  <div class="py-12 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbs} lang={lang} className="mb-8" />
      
      <!-- Top Title -->
      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          Demo Migrations & Delivery Specs
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          In accordance with our strict transparency policy, we do not display fictitious client logos or fabricated testimonials. Below are visual mockups and technical specifications of our standardized benchmark migrations.
        </p>
      </div>

      <!-- Projects List with High-Res Visual Mockups -->
      <div class="space-y-16 mb-24">
        {demoProjects.map((proj) => (
          <div class="rounded-xl bg-white border border-slate-200 overflow-hidden shadow-2xs">
            
            <!-- Top Split: Left Image + Right Header & Scope -->
            <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-slate-200">
              <div class="lg:col-span-6 relative bg-slate-100 border-b lg:border-b-0 lg:border-r border-slate-200 overflow-hidden group min-h-[320px]">
                <img 
                  src={proj.image} 
                  alt={proj.title} 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute top-4 left-4 px-3 py-1 rounded-md bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-2xs backdrop-blur-md">
                  {proj.type}
                </div>
              </div>

              <div class="lg:col-span-6 p-8 sm:p-10 flex flex-col justify-between space-y-6 bg-white">
                <div class="space-y-3">
                  <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">{proj.title}</h2>
                  <div class="space-y-1.5 text-xs font-mono pt-1">
                    <div class="text-slate-600"><span class="text-slate-800 font-semibold">BEFORE:</span> {proj.from}</div>
                    <div class="text-slate-700 font-medium"><span class="text-slate-900 font-semibold">AFTER:</span> {proj.to}</div>
                  </div>
                </div>

                <!-- Scope Specs -->
                <div class="grid grid-cols-2 gap-3 text-xs bg-slate-50 p-4 rounded-lg border border-slate-200 font-mono">
                  <div>
                    <span class="text-slate-500 font-sans block mb-0.5">Pages</span>
                    <span class="font-bold text-slate-900">{proj.scope.pages}</span>
                  </div>
                  <div>
                    <span class="text-slate-500 font-sans block mb-0.5">Articles</span>
                    <span class="font-bold text-slate-900">{proj.scope.posts}</span>
                  </div>
                  <div>
                    <span class="text-slate-500 font-sans block mb-0.5">Templates</span>
                    <span class="font-bold text-slate-900">{proj.scope.templates}</span>
                  </div>
                  <div>
                    <span class="text-slate-500 font-sans block mb-0.5">Endpoints</span>
                    <span class="font-bold text-slate-900">{proj.scope.forms}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom Details: Metrics + Verified Checklist -->
            <div class="p-8 sm:p-10 space-y-8 bg-slate-50/50">
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-4">Benchmark Before / After Telemetry</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  {proj.metrics.map((m) => (
                    <div class="p-4 rounded-lg bg-white border border-slate-200 space-y-1 shadow-2xs">
                      <p class="text-xs text-slate-500 font-medium">{m.label}</p>
                      <div class="flex items-baseline gap-2.5">
                        <span class="text-xs line-through text-slate-400 font-mono">{m.before}</span>
                        <span class="text-base font-extrabold text-slate-900 font-mono">{m.after}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">Verified Delivery Checklist</h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-slate-700">
                  {proj.verifiedItems.map((item) => (
                    <li class="flex items-start gap-2.5 p-3.5 rounded-lg bg-white border border-slate-200 shadow-2xs">
                      <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- Visual URL Scanner & CMS Preview -->
      <div class="mb-24">
        <VisualUrlMapper lang={lang} />
      </div>

      <!-- Bottom CTA -->
      <div class="text-center">
        <a href={estimatePath} class="inline-block px-8 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-sm shadow-amber-500/20 transition-all">
          Request an Analysis of Your Website
        </a>
      </div>

    </div>
  </div>
</Layout>
