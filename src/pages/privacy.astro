---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { type Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<Layout 
  title="Privacy Policy | SiteCarry"
  description="Privacy policy and data protection practices at SiteCarry."
  lang={lang}
>
  <div class="py-20 sm:py-24 bg-[#faf9f6] border-b border-[#e8e6df]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-slate-700 space-y-6 leading-relaxed">
      
      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1c2024] tracking-tight mb-2">Privacy Policy</h1>
        <p class="text-xs text-slate-500 font-mono">Effective Date: October 2026</p>
      </div>

      <p>
        At SiteCarry (<code class="text-amber-900 font-mono bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200/80">sitecarry.com</code>), we treat your data and intellectual property with utmost confidentiality and engineering discipline. This policy outlines how information is collected, processed, and safeguarded.
      </p>

      <h2 class="text-lg font-bold text-slate-900 pt-4">1. Information We Collect</h2>
      <p>
        When you submit an estimate request or project brief, we collect information you voluntarily provide, including:
      </p>
      <ul class="list-disc list-inside space-y-1.5 text-slate-600">
        <li>Your contact name and business email address.</li>
        <li>Current website URL and technical objectives.</li>
        <li>Rough page/article volume estimates and budget range.</li>
      </ul>
      <p class="p-4 rounded-xl bg-white border border-[#e8e6df] text-xs text-slate-600 shadow-2xs">
        <strong class="text-slate-900">Note:</strong> We never collect or request administrative passwords, root SSH keys, or database credentials through our public web forms. Technical credentials required during project execution are exchanged via encrypted channels.
      </p>

      <h2 class="text-lg font-bold text-slate-900 pt-4">2. How Your Information is Used</h2>
      <p>
        Information submitted is used exclusively for:
      </p>
      <ul class="list-disc list-inside space-y-1.5 text-slate-600">
        <li>Performing preliminary technical crawling of the provided URL to formulate your migration estimate.</li>
        <li>Communicating with you regarding your inquiry, scope proposal, or diagnostic report.</li>
        <li>Executing authorized migration agreements.</li>
      </ul>
      <p>We do not sell, rent, or trade client information to any third-party marketing brokers.</p>

      <h2 class="text-lg font-bold text-slate-900 pt-4">3. Data Retention & Client Privacy</h2>
      <p>
        Inquiry records and technical crawl audits are retained only as long as necessary to facilitate service proposals or ongoing maintenance contracts. You may request the deletion of your inquiry data at any time by contacting us at <code class="text-slate-900 font-mono bg-white border border-[#e8e6df] px-1.5 py-0.5 rounded">{siteConfig.contactEmail}</code>.
      </p>

      <h2 class="text-lg font-bold text-slate-900 pt-4">4. Contact Information</h2>
      <p>
        If you have questions regarding this Privacy Policy, please email us directly at <code class="text-amber-800 font-mono bg-amber-50 border border-amber-200/80 px-1.5 py-0.5 rounded">{siteConfig.contactEmail}</code>.
      </p>

    </div>
  </div>
</Layout>
