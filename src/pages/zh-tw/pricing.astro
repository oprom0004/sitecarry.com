---
import Layout from '../../layouts/Layout.astro';
import PricingTable from '../../components/PricingTable.astro';
import { siteConfig } from '../../data/siteConfig';
import { getLocalizedPath, type Lang } from '../../i18n/utils';

const lang: Lang = 'zh-tw';
const estimatePath = getLocalizedPath('estimate', lang);
const checkoutPath = getLocalizedPath('checkout', lang);

const zhAddOns = [
  {
    item: "擴充新頁面（沿用既有模組版型）",
    priceRange: "$80 – $150",
    unit: "每頁",
    note: "客戶提供最終定稿文案與配圖素材",
  },
  {
    item: "全新客製獨立版型設計與刻板",
    priceRange: "$300 – $600",
    unit: "每套版型",
    note: "包含專屬響應式 UI 設計與元件組裝",
  },
  {
    item: "批量遷移歷史文章（每 100 篇）",
    priceRange: "$200 – $400",
    unit: "每 100 篇",
    note: "格式自動清洗、圖片路徑正規化與欄位對齊",
  },
  {
    item: "WooCommerce / 電商商品批量遷移 (每 500 SKU)",
    priceRange: "$300 – $600",
    unit: "每 500 商品",
    note: "含規格變體、屬性、商品相簿與分類遷移",
  },
  {
    item: "無頭金流結帳網關串接 (Stripe / Shopify / 本地金流)",
    priceRange: "$500 – $1,200",
    unit: "每組金流",
    note: "合規 PCI-DSS 託管權杖化結帳，杜絕信用卡側錄",
  },
  {
    item: "額外擴充多語系獨立分支",
    priceRange: "+25% – 40%",
    unit: "基礎專案總價",
    note: "國際化語系路由、嚴格 hreflang 配置；客戶提供翻譯文案",
  },
  {
    item: "第三方商務系統串接",
    priceRange: "$250 – $600",
    unit: "每個系統",
    note: "例如 HubSpot、Mailchimp、Calendly、Zapier Webhook 等",
  },
];
---

<Layout 
  title="收費方案與增項費率 | 透明固定總價合約"
  description="WordPress 老站移轉與改版收費標準。USD $1,490 起固定總價合約，USD $149 深度先期診斷，無隱藏工時追加。"
  lang={lang}
>
  <div class="py-20 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          清晰透明、可預期的專案預算
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          我們不按工時無上限灌水計費。所有專案在開工前皆確認明確交付範疇，於測試機完成全站驗收，並提供上線後 30 天交付瑕疵保固。
        </p>
      </div>

      <PricingTable lang={lang} showAllDetails={true} />

      <!-- USD $149 深度先期診斷 -->
      <div class="mt-16 p-8 sm:p-10 rounded-xl bg-slate-50 border border-slate-200 max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xs">
        <div class="space-y-3">
          <span class="text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200/80 px-2.5 py-1 rounded-md inline-block">
            Step 0: 低風險先期清查
          </span>
          <h2 class="text-2xl font-bold text-slate-900">深度移轉診斷審查 (USD $149)</h2>
          <p class="text-sm text-slate-600 leading-relaxed max-w-xl">
            提供完整 URL 清冊、外掛依賴與風險清單、資料庫清理方案與目標架構設計書，3–5 個工作天交付。<strong class="text-amber-900 font-semibold">30 天內簽約委託改版者，診斷費全額折抵工程款（實質免費）</strong>。
          </p>
        </div>
        <a href={`${checkoutPath}?plan=review-149`} class="shrink-0 px-7 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-sm shadow-amber-500/20 transition-all">
          線上支付 $149 立即啟動審查
        </a>
      </div>

      <!-- 增項報價表 -->
      <div class="mt-20 max-w-5xl mx-auto">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">常見增項公開計費標準</h2>
          <p class="text-sm text-slate-600">所有頁面擴充、額外語系或自訂系統整合，均在實施前雙方書面確認固定報價，絕不事後突襲收費。</p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-2xs">
          <table class="w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-xs tracking-wider">
              <tr>
                <th class="px-6 py-3.5">增項範疇</th>
                <th class="px-6 py-3.5">參考單價</th>
                <th class="px-6 py-3.5">計價單位</th>
                <th class="px-6 py-3.5">備註細節</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {zhAddOns.map((add) => (
                <tr class="hover:bg-slate-50/70 transition-colors">
                  <td class="px-6 py-4 font-medium text-slate-900">{add.item}</td>
                  <td class="px-6 py-4 text-blue-600 font-bold font-mono">{add.priceRange}</td>
                  <td class="px-6 py-4 text-slate-500 font-mono text-xs">{add.unit}</td>
                  <td class="px-6 py-4 text-slate-600 text-xs">{add.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- 每月維護與監控方案 (選購) -->
      <div class="mt-20 max-w-5xl mx-auto">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-2">每月維護與健康監控計畫</h2>
          <p class="text-sm text-slate-600">在 30 天上線保固期過後，可選購由工程團隊提供的持續監控與支援服務。</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-baseline mb-4">
                <h3 class="text-xl font-bold text-slate-900">基礎防護維護 (Care)</h3>
                <div class="text-right">
                  <span class="text-2xl font-extrabold text-slate-900 font-mono">$79</span>
                  <span class="text-xs text-slate-500 font-mono"> / 月</span>
                </div>
              </div>
              <p class="text-sm text-slate-600 mb-6 font-normal">全天候正常運行監控、自動化建置警報與安全性巡檢，給您安心的被動守護。</p>
              <ul class="space-y-2.5 text-sm text-slate-600 mb-8">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>24/7 全天候上線率與 DNS 延遲監控</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>自動化建置失敗即時警報與排錯</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>每月相依套件與儲存庫安全漏洞掃描</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>定期備份有效性查驗與還原演練</span>
                </li>
              </ul>
            </div>
            <a href={`${estimatePath}?care=care`} class="py-3 px-4 rounded-xl bg-slate-50 hover:bg-amber-500 hover:text-slate-950 border border-slate-200 text-slate-800 text-xs font-semibold text-center transition-all">
              諮詢 Care 基礎維護方案
            </a>
          </div>

          <div class="p-8 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-baseline mb-4">
                <h3 class="text-xl font-bold text-slate-900">進階維護 (Care Plus)</h3>
                <div class="text-right">
                  <span class="text-2xl font-extrabold text-slate-900 font-mono">$199</span>
                  <span class="text-xs text-slate-500 font-mono"> / 月</span>
                </div>
              </div>
              <p class="text-sm text-slate-600 mb-6 font-normal">包含 Care 全部監控項目，再加上每月專屬工程師工時，支援文案修改與版面微調。</p>
              <ul class="space-y-2.5 text-sm text-slate-600 mb-8">
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>包含所有 Care 監控與安全巡檢項目</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>每月 2 小時專屬工程師支援（文案、圖檔替換、細微排版）</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>每季 SEO 健康度與 Core Web Vitals 測速報告</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>享有技術諮詢優先回應權</span>
                </li>
              </ul>
            </div>
            <a href={`${estimatePath}?care=care-plus`} class="py-3 px-4 rounded-xl bg-slate-50 hover:bg-amber-500 hover:text-slate-950 border border-slate-200 text-slate-800 text-xs font-semibold text-center transition-all">
              諮詢 Care Plus 進階維護方案
            </a>
          </div>
        </div>
      </div>

      <!-- 付款期數與範疇條款 -->
      <div class="mt-20 max-w-5xl mx-auto p-8 rounded-xl bg-slate-50 border border-slate-200 space-y-4 text-sm text-slate-600 shadow-2xs">
        <h3 class="text-base font-bold text-slate-900 tracking-tight">付款時程與專案範疇約定</h3>
        <ul class="space-y-3 text-slate-600 list-disc list-inside">
          <li><strong class="text-slate-800">諮詢與付款流程：</strong> 我們非線上刷卡商城。所有專案皆始於提交網址免費盤點，雙方書面確認固定總價與交付規格後，依工程進度分期電匯支付，不事先在線上扣款。</li>
          <li><strong class="text-slate-800">付款期數：</strong> Essential 方案為簽約開工 50% 定金，測試機驗收完成、切換 DNS 上線前支付 50% 尾款。Business 與 Enterprise 方案為開工 40% 定金、測試機完整驗收 40%、正式上線切換前 20%。</li>
          <li><strong class="text-slate-800">WooCommerce 與電商範疇：</strong> 企業級重構採用 Next.js Commerce 前後端分離無頭架構，結合合規 PCI-DSS 託管結帳（如 Stripe Checkout / Shopify）。遷移涵蓋既有商品目錄、規格變體、分類標籤與歷史顧客訂單。特殊自訂 ERP 或多倉庫對接，於初期需求盤點時單獨明確約定。</li>
          <li><strong class="text-slate-800">修訂驗收輪次：</strong> 每個專案包含測試機環境上的 2 輪彙整修訂反饋。修復未達原合約規格之交付瑕疵不計入修訂輪次。</li>
          <li><strong class="text-slate-800">主機帳號自主權：</strong> 我們直接部署至客戶自有名下的雲端帳戶（如 Cloudflare Pages、Vercel、AWS）。所有原始碼、Git 儲存庫與平台憑證皆為客戶 100% 獨立擁有。</li>
          <li><strong class="text-slate-800">內容與翻譯文案：</strong> 客戶負責提供最終定稿文案與多語系翻譯對照。歷史文章與商品資料由自動化管線批量清洗遷移，不包含文案的人工重新撰寫。</li>
        </ul>
      </div>

    </div>
  </div>
</Layout>
