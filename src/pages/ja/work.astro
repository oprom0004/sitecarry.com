---
import Layout from '../../layouts/Layout.astro';
import VisualUrlMapper from '../../components/VisualUrlMapper.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getLocalizedPath, type Lang } from '../../i18n/utils';

const lang: Lang = 'ja';
const estimatePath = getLocalizedPath('estimate', lang);

const breadcrumbs = [
  { label: '移行実績・事例' },
];
---

<Layout 
  title="移行実績とベンチマーク検証 | SiteCarry"
  description="架空のロゴや誇大な数字は掲載しません。標準化された移行ベンチマークと実測パフォーマンス、UIプレビューを公開しています。"
  lang={lang}
>
  <div class="py-12 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbs} lang={lang} className="mb-8" />
      
      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
          デモ移行検証とUIプレビュー
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          当スタジオでは、架空の顧客ロゴや偽の推薦文を掲載することは一切ありません。標準的な企業サイトを対象とした検証用デモ移行のUIイメージと実測値を公開しています。
        </p>
      </div>

      <div class="rounded-xl bg-white border border-slate-200 overflow-hidden shadow-2xs mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12">
          <div class="lg:col-span-6 relative bg-slate-100 border-b lg:border-b-0 lg:border-r border-slate-200 min-h-[320px]">
            <img src="/images/demo-b2b-portal.png" alt="B2B企業サイト移行デモ" class="w-full h-full object-cover" />
            <div class="absolute top-4 left-4 px-3 py-1 rounded-md bg-white/95 border border-slate-200 text-xs font-semibold text-slate-700 shadow-2xs backdrop-blur-md">
              DEMO BENCHMARK 01
            </div>
          </div>
          <div class="lg:col-span-6 p-8 sm:p-10 space-y-6 flex flex-col justify-between bg-white">
            <div class="space-y-4">
              <h2 class="text-2xl font-bold text-slate-900 mb-2">B2B製造業コーポレートサイト移行モデル</h2>
              <p class="text-sm text-slate-500 font-mono">WP 6.4 + プラグイン28個 ($49/月 VPS) → Astro 7 静的化 (Cloudflare Pages $0/月)</p>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="p-3.5 bg-slate-50 rounded-lg border border-slate-200 space-y-1">
                  <p class="text-xs text-slate-500 font-medium">表示速度</p>
                  <p class="text-xl font-bold text-slate-900 font-mono">0.8秒</p>
                  <p class="text-xs text-slate-400 font-mono">元: 6.2秒</p>
                </div>
                <div class="p-3.5 bg-slate-50 rounded-lg border border-slate-200 space-y-1">
                  <p class="text-xs text-slate-500 font-medium">Lighthouse</p>
                  <p class="text-xl font-bold text-slate-900 font-mono">99/100</p>
                  <p class="text-xs text-slate-400 font-mono">元: 43点</p>
                </div>
                <div class="p-3.5 bg-slate-50 rounded-lg border border-slate-200 space-y-1">
                  <p class="text-xs text-slate-500 font-medium">PHP脆弱性</p>
                  <p class="text-xl font-bold text-slate-900 font-mono">ゼロ</p>
                  <p class="text-xs text-slate-400">完全撤廃</p>
                </div>
                <div class="p-3.5 bg-slate-50 rounded-lg border border-slate-200 space-y-1">
                  <p class="text-xs text-slate-500 font-medium">URL保持</p>
                  <p class="text-xl font-bold text-slate-900 font-mono">100%</p>
                  <p class="text-xs text-slate-400 font-mono">全195件転送</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mb-24">
        <VisualUrlMapper lang={lang} />
      </div>

      <div class="text-center">
        <a href={estimatePath} class="inline-block px-8 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-sm shadow-amber-500/20 transition-all">
          自社サイトの移行可否を相談する
        </a>
      </div>

    </div>
  </div>
</Layout>
