---

<Layout title={t.pageTitle} description={t.pageDesc} lang={lang}>
  <div class="py-12 sm:py-16 bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <Breadcrumb items={breadcrumbs} lang={lang} className="mb-6" />

      <!-- Header -->
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
          {t.title}
        </h1>
        <p class="text-base text-slate-600 leading-relaxed font-normal">
          {t.subtitle}
        </p>
      </div>

      <!-- Main Checkout Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start max-w-5xl mx-auto">
        
        <!-- Left Column: Plan Summary & Selector (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Plan Selector Box -->
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200 shadow-2xs space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700">{t.choosePlan}</span>
              <span class="text-[11px] text-slate-500">{t.switchHint}</span>
            </div>

            <div class="space-y-2" id="plan-buttons">
              <button 
                type="button" 
                data-plan="review-149" 
                class="plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-blue-600 ring-2 ring-blue-500/20 shadow-xs"
              >
                <div>
                  <div class="font-bold text-xs text-slate-900 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 rounded text-[10px] bg-blue-100 text-blue-800 font-mono">Step 0</span>
                    {plansData['review-149'].title[lang] || plansData['review-149'].title.en}
                  </div>
                  <span class="text-[11px] text-slate-500">3–5 days turnaround</span>
                </div>
                <div class="text-right">
                  <span class="font-extrabold text-base text-blue-600 font-mono">$149</span>
                  <span class="text-[10px] block text-slate-500 font-mono">USD</span>
                </div>
              </button>

              <button 
                type="button" 
                data-plan="essential-deposit" 
                class="plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-slate-200 hover:border-slate-300"
              >
                <div>
                  <div class="font-bold text-xs text-slate-900 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 rounded text-[10px] bg-slate-100 text-slate-700 font-mono">50%</span>
                    {plansData['essential-deposit'].title[lang] || plansData['essential-deposit'].title.en}
                  </div>
                  <span class="text-[11px] text-slate-500">Full: $1,490</span>
                </div>
                <div class="text-right">
                  <span class="font-extrabold text-base text-slate-900 font-mono">$745</span>
                  <span class="text-[10px] block text-slate-500 font-mono">Deposit</span>
                </div>
              </button>

              <button 
                type="button" 
                data-plan="business-deposit" 
                class="plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-slate-200 hover:border-slate-300"
              >
                <div>
                  <div class="font-bold text-xs text-slate-900 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 rounded text-[10px] bg-amber-100 text-amber-800 font-mono">40%</span>
                    {plansData['business-deposit'].title[lang] || plansData['business-deposit'].title.en}
                  </div>
                  <span class="text-[11px] text-slate-500">Full: $3,490</span>
                </div>
                <div class="text-right">
                  <span class="font-extrabold text-base text-slate-900 font-mono">$1,396</span>
                  <span class="text-[10px] block text-slate-500 font-mono">Deposit</span>
                </div>
              </button>

              <button 
                type="button" 
                data-plan="enterprise-deposit" 
                class="plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-slate-200 hover:border-slate-300"
              >
                <div>
                  <div class="font-bold text-xs text-slate-900 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-100 text-emerald-800 font-mono">40%</span>
                    {plansData['enterprise-deposit'].title[lang] || plansData['enterprise-deposit'].title.en}
                  </div>
                  <span class="text-[11px] text-slate-500">Full: $6,900</span>
                </div>
                <div class="text-right">
                  <span class="font-extrabold text-base text-slate-900 font-mono">$2,760</span>
                  <span class="text-[10px] block text-slate-500 font-mono">Deposit</span>
                </div>
              </button>
            </div>
          </div>

          <!-- Dynamic Active Plan Summary Card -->
          <div class="p-6 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-4">
            <div class="pb-4 border-b border-slate-100 flex items-start justify-between">
              <div>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{t.planLabel}</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1" id="active-plan-title">
                  {plansData['review-149'].title[lang] || plansData['review-149'].title.en}
                </h3>
              </div>
              <div class="text-right">
                <span class="text-3xl font-extrabold text-blue-600 font-mono" id="active-plan-price">$149</span>
                <span class="text-xs text-slate-500 block font-mono">USD</span>
              </div>
            </div>

            <!-- Full price comparison note if deposit -->
            <div class="hidden text-xs text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200" id="deposit-note-box">
              <span class="font-bold text-slate-900">{t.fullPrice}:</span> <span id="active-full-price" class="font-mono font-semibold">$1,490</span> USD.
              <span class="block text-slate-500 mt-0.5" id="deposit-milestone-text">Remainder due upon preview acceptance.</span>
            </div>

            <!-- Guarantee Note -->
            <div class="p-3 bg-amber-50/70 rounded-lg border border-amber-200/80 text-xs text-amber-900 leading-relaxed font-medium" id="plan-guarantee-text">
              {t.creditedNote}
            </div>

            <!-- What Happens Next -->
            <div class="space-y-2 pt-2 text-xs text-slate-600">
              <span class="font-bold text-slate-800 block">{t.whatHappensNext}</span>
              <p>{t.step1}</p>
              <p>{t.step2}</p>
              <p>{t.step3}</p>
            </div>

            <!-- Security Commitment Strip -->
            <div class="pt-4 border-t border-slate-100 space-y-1.5 text-[11px] text-slate-500">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{t.sec1}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{t.sec2}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <span>{t.sec3}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column: Checkout Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-xl bg-white border border-slate-200 shadow-2xs space-y-8">
            
            <form id="checkout-form" class="space-y-7">
              <input type="hidden" name="plan_id" id="input-plan-id" value="review-149" />
              <input type="hidden" name="amount" id="input-amount" value="149" />
              <input type="hidden" name="lang" value={lang} />
              <input type="text" name="website_trap_field" class="hidden" tabindex="-1" autocomplete="off" />

              <!-- Step 1: Contact Information -->
              <div class="space-y-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 pb-2 border-b border-slate-100">
                  {t.projectDetails}
                </h3>

                <div>
                  <label for="checkout-url" class="block text-xs font-bold text-slate-700 mb-1.5">
                    {t.websiteUrl} *
                  </label>
                  <input 
                    type="url" 
                    id="checkout-url" 
                    name="website_url" 
                    required 
                    placeholder="https://example.com"
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition-all font-mono"
                  />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="checkout-email" class="block text-xs font-bold text-slate-700 mb-1.5">
                      {t.email} *
                    </label>
                    <input 
                      type="email" 
                      id="checkout-email" 
                      name="email" 
                      required 
                      placeholder="name@company.com"
                      class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition-all"
                    />
                  </div>
                  <div>
                    <label for="checkout-name" class="block text-xs font-bold text-slate-700 mb-1.5">
                      {t.fullName} *
                    </label>
                    <input 
                      type="text" 
                      id="checkout-name" 
                      name="name" 
                      required 
                      placeholder="First & Last Name"
                      class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition-all"
                    />
                  </div>
                </div>

                <div>
                  <label for="checkout-company" class="block text-xs font-bold text-slate-700 mb-1.5">
                    {t.company}
                  </label>
                  <input 
                    type="text" 
                    id="checkout-company" 
                    name="company" 
                    placeholder="Acme Corp, Inc."
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition-all"
                  />
                </div>
              </div>

              <!-- Step 2: Payment Method Selector Tabs -->
              <div class="space-y-4">
                <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 pb-2 border-b border-slate-100">
                  {t.paymentMethod}
                </h3>

                <!-- Method Switcher -->
                <div class="grid grid-cols-2 gap-3" id="method-switcher">
                  <button 
                    type="button" 
                    data-method="stripe_card"
                    class="method-tab p-3 rounded-lg border text-center font-semibold text-xs transition-all bg-white border-blue-600 text-blue-700 ring-2 ring-blue-500/10 shadow-2xs cursor-pointer"
                  >
                    {t.tabCard}
                  </button>
                  <button 
                    type="button" 
                    data-method="bank_wire"
                    class="method-tab p-3 rounded-lg border text-center font-semibold text-xs transition-all bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300 cursor-pointer"
                  >
                    {t.tabWire}
                  </button>
                </div>
                <input type="hidden" name="payment_method" id="input-payment-method" value="stripe_card" />

                <!-- Card Panel -->
                <div id="panel-card" class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
                  <div class="flex items-center justify-between text-xs text-slate-500">
                    <span class="font-medium">{t.cardHint}</span>
                    <span class="font-mono font-bold text-slate-700">256-Bit SSL</span>
                  </div>

                  <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">{t.cardNumber}</label>
                    <div class="relative">
                      <input 
                        type="text" 
                        maxlength="19"
                        id="card-number"
                        placeholder="4242 •••• •••• 4242" 
                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-2.5 text-sm font-mono text-slate-900 focus:outline-none focus:border-blue-600"
                      />
                      <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-mono">VISA / MC</span>
                    </div>
                  </div>

                  <div class="grid grid-cols-3 gap-3">
                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">{t.cardExp}</label>
                      <input 
                        type="text" 
                        maxlength="5"
                        placeholder="MM/YY" 
                        class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-mono text-slate-900 focus:outline-none focus:border-blue-600"
                      />
                    </div>
                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">{t.cardCvc}</label>
                      <input 
                        type="text" 
                        maxlength="4"
                        placeholder="CVC" 
                        class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-mono text-slate-900 focus:outline-none focus:border-blue-600"
                      />
                    </div>
                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">{t.cardZip}</label>
                      <input 
                        type="text" 
                        placeholder="ZIP" 
                        class="w-full bg-white border border-slate-200 rounded-lg px-3 py-2.5 text-sm font-mono text-slate-900 focus:outline-none focus:border-blue-600"
                      />
                    </div>
                  </div>
                </div>

                <!-- Bank Wire Panel -->
                <div id="panel-wire" class="hidden p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
                  <div class="text-xs text-slate-700 font-bold">
                    {t.wireNotice}
                  </div>
                  <div class="space-y-2 text-xs font-mono bg-white p-4 rounded-lg border border-slate-200 text-slate-700">
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1 border-b border-slate-100">
                      <span class="text-slate-500 font-sans">{t.beneficiary}:</span>
                      <strong class="text-slate-900">SHEN ZHEN YUN QI SHI KE JI YOU XIAN GONG SI</strong>
                    </div>
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1 border-b border-slate-100">
                      <span class="text-slate-500 font-sans">{t.bankName}:</span>
                      <strong class="text-slate-900">DBS Bank (Hong Kong) Limited</strong>
                    </div>
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1 border-b border-slate-100">
                      <span class="text-slate-500 font-sans">{t.accountNo}:</span>
                      <strong class="text-blue-700 font-bold text-sm">795001126 (USD)</strong>
                    </div>
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1 border-b border-slate-100">
                      <span class="text-slate-500 font-sans">{t.swift}:</span>
                      <strong class="text-slate-900">DHBKHKHH</strong>
                    </div>
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1 border-b border-slate-100">
                      <span class="text-slate-500 font-sans">{t.bankCode}:</span>
                      <strong class="text-slate-900">Bank 016 / Branch 478</strong>
                    </div>
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center py-1">
                      <span class="text-slate-500 font-sans">{t.bankAddr}:</span>
                      <span class="text-slate-600 text-[11px]">18/F, The Center, 99 Queen’s Road Central, Hong Kong</span>
                    </div>
                  </div>
                  <p class="text-xs text-slate-500 leading-relaxed">
                    {t.wireInstruction}
                  </p>
                </div>
              </div>

              <!-- Error Box -->
              <div id="checkout-error" class="hidden p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs font-mono"></div>

              <!-- Submit Action Button -->
              <div class="space-y-3 pt-2">
                <button 
                  type="submit" 
                  id="checkout-submit-btn"
                  class="w-full py-4 px-6 rounded-lg bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold text-sm shadow-sm shadow-blue-500/25 transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  <span id="submit-btn-label">{t.payBtnCard}</span>
                </button>

                <div class="text-center pt-2">
                  <a href={estimatePath} class="text-xs text-slate-600 hover:text-blue-600 font-medium transition-colors">
                    {t.freeConsultAlt}
                  </a>
                </div>
              </div>

            </form>

            <!-- Success Card -->
            <div id="checkout-success" class="hidden py-8 text-center space-y-6">
              <div class="w-16 h-16 bg-emerald-50 border border-emerald-200 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-sm">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>

              <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-2">{t.orderSuccess}</h3>
                <p class="text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
                  {t.orderSuccessDesc}
                </p>
              </div>

              <div class="inline-block p-4 bg-slate-50 rounded-xl border border-slate-200 text-xs font-mono text-slate-800">
                <span class="text-slate-500 block text-[10px] uppercase font-sans mb-1">{t.orderTracking}</span>
                <span class="text-lg font-extrabold text-blue-700 tracking-wider" id="confirmed-order-id">SC-ORD-20261025-0000</span>
              </div>

              <div class="pt-4">
                <a href={estimatePath} class="text-xs text-blue-600 hover:text-blue-700 font-semibold underline underline-offset-2">
                  ← Back to Home / Services
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script is:inline define:vars={{ plansData, lang }}>
  // Inline script runs synchronously to read query params and handle fast switching
  (function() {
    var searchParams = new URLSearchParams(window.location.search);
    var planParam = searchParams.get('plan') || 'review-149';
    var urlParam = searchParams.get('url');

    var currentPlanId = plansData[planParam] ? planParam : 'review-149';

    // Pre-fill URL if passed
    if (urlParam) {
      var urlInput = document.getElementById('checkout-url');
      if (urlInput) urlInput.value = urlParam;
    }

    // Function to update active plan UI
    function selectPlan(planId) {
      currentPlanId = planId;
      var plan = plansData[planId] || plansData['review-149'];

      // Update hidden inputs
      var inputPlan = document.getElementById('input-plan-id');
      var inputAmount = document.getElementById('input-amount');
      if (inputPlan) inputPlan.value = planId;
      if (inputAmount) inputAmount.value = plan.price;

      // Update active title & price
      var titleEl = document.getElementById('active-plan-title');
      var priceEl = document.getElementById('active-plan-price');
      if (titleEl) titleEl.innerText = plan.title[lang] || plan.title.en;
      if (priceEl) priceEl.innerText = plan.priceDisplay;

      // Update deposit note box
      var depositBox = document.getElementById('deposit-note-box');
      var fullPriceEl = document.getElementById('active-full-price');
      if (depositBox && fullPriceEl) {
        if (plan.isDeposit) {
          depositBox.classList.remove('hidden');
          fullPriceEl.innerText = plan.fullPriceDisplay;
        } else {
          depositBox.classList.add('hidden');
        }
      }

      // Update plan buttons style
      var btns = document.querySelectorAll('.plan-btn');
      btns.forEach(function(b) {
        if (b.getAttribute('data-plan') === planId) {
          b.className = 'plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-blue-600 ring-2 ring-blue-500/20 shadow-xs';
        } else {
          b.className = 'plan-btn w-full p-3 rounded-lg border text-left flex items-center justify-between transition-all bg-white border-slate-200 hover:border-slate-300';
        }
      });

      // Update submit button price label
      updateButtonLabel();
    }

    function updateButtonLabel() {
      var method = document.getElementById('input-payment-method').value;
      var btnLabel = document.getElementById('submit-btn-label');
      var plan = plansData[currentPlanId] || plansData['review-149'];

      if (btnLabel) {
        if (method === 'bank_wire') {
          btnLabel.innerText = 'Generate Pro-Forma Invoice & Reserve Sprint (' + plan.priceDisplay + ' USD)';
        } else {
          btnLabel.innerText = 'Pay ' + plan.priceDisplay + ' USD & Lock Sprint';
        }
      }
    }

    // Set initial plan
    selectPlan(currentPlanId);

    // Attach click listeners to plan buttons
    document.querySelectorAll('.plan-btn').forEach(function(b) {
      b.addEventListener('click', function() {
        var p = b.getAttribute('data-plan');
        if (p) selectPlan(p);
      });
    });

    // Method switcher
    var methodBtns = document.querySelectorAll('.method-tab');
    var panelCard = document.getElementById('panel-card');
    var panelWire = document.getElementById('panel-wire');
    var inputMethod = document.getElementById('input-payment-method');

    methodBtns.forEach(function(mb) {
      mb.addEventListener('click', function() {
        var m = mb.getAttribute('data-method');
        if (inputMethod) inputMethod.value = m;

        methodBtns.forEach(function(btn) {
          if (btn === mb) {
            btn.className = 'method-tab p-3 rounded-lg border text-center font-semibold text-xs transition-all bg-white border-blue-600 text-blue-700 ring-2 ring-blue-500/10 shadow-2xs cursor-pointer';
          } else {
            btn.className = 'method-tab p-3 rounded-lg border text-center font-semibold text-xs transition-all bg-slate-50 border-slate-200 text-slate-600 hover:border-slate-300 cursor-pointer';
          }
        });

        if (m === 'bank_wire') {
          if (panelCard) panelCard.classList.add('hidden');
          if (panelWire) panelWire.classList.remove('hidden');
        } else {
          if (panelCard) panelCard.classList.remove('hidden');
          if (panelWire) panelWire.classList.add('hidden');
        }

        updateButtonLabel();
      });
    });

    // Form submit handler
    var checkoutForm = document.getElementById('checkout-form');
    var errorBox = document.getElementById('checkout-error');
    var successBox = document.getElementById('checkout-success');
    var submitBtn = document.getElementById('checkout-submit-btn');

    if (checkoutForm && errorBox && successBox && submitBtn) {
      checkoutForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        errorBox.classList.add('hidden');
        errorBox.innerText = '';

        submitBtn.disabled = true;
        var originalText = submitBtn.innerText;
        submitBtn.innerText = 'Securing Sprint & Processing...';

        var formData = new FormData(checkoutForm);
        var data = {};
        formData.forEach(function(val, key) { data[key] = val; });

        try {
          var res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          var result = await res.json();
          if (!res.ok || result.error) {
            throw new Error(result.error || 'Payment error occurred. Please try again.');
          }

          var orderEl = document.getElementById('confirmed-order-id');
          if (orderEl) orderEl.innerText = result.orderId;

          checkoutForm.classList.add('hidden');
          successBox.classList.remove('hidden');
        } catch(err) {
          errorBox.classList.remove('hidden');
          errorBox.innerText = err.message || 'Error processing request.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerText = originalText;
        }
      });
    }

  })();
</script>
